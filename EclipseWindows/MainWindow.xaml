<Window
    x:Class="Eclipse.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Eclipse">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <Style x:Key="RailItemStyle" TargetType="NavigationViewItem">
                <Setter Property="Height" Value="48" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="Back_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{ThemeResource EclipseRailBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="84" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Image Source="Assets/EclipseAppIcon.png" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Eclipse" />
                <NavigationView Grid.Row="1"
        x:Name="ShellNavigation"
        AutomationProperties.AutomationId="EclipseShell"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        CompactPaneLength="80"
        OpenPaneLength="80"
        IsPaneOpen="False"
        IsPaneToggleButtonVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        MenuItemContainerStyle="{StaticResource RailItemStyle}"
        ItemInvoked="Navigation_ItemInvoked">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{ThemeResource EclipseRailColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource EclipseRailIconColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource EclipseRailSelectedForegroundColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource EclipseRailSelectedForegroundColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource EclipseRailSelectedForegroundColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource EclipseRailSelectedBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource EclipseRailSelectedBackgroundColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource EclipseRailSelectedBackgroundColor}" />
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="Home" Icon="Home" Tag="Home" IsSelected="True" AutomationProperties.Name="Home" ToolTipService.ToolTip="Home" />
            <NavigationViewItem Content="Schedule" Tag="Schedule" AutomationProperties.Name="Schedule" ToolTipService.ToolTip="Schedule"><NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Downloads" Tag="Downloads" AutomationProperties.Name="Downloads" ToolTipService.ToolTip="Downloads"><NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Library" Tag="Library" AutomationProperties.Name="Library" ToolTipService.ToolTip="Library"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Search" Tag="Search" AutomationProperties.Name="Search" ToolTipService.ToolTip="Search"><NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="Settings" Style="{StaticResource RailItemStyle}" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.FooterMenuItems>
                </NavigationView>
            </Grid>
        </Border>
        <Frame x:Name="ContentFrame" Grid.Column="1" Navigated="ContentFrame_Navigated" />
    </Grid>
</Window>


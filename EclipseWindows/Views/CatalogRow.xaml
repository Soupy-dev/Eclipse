<UserControl x:Class="Eclipse.Windows.Views.CatalogRow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" MinHeight="380">
    <!-- Cards lift on hover (CardLift); the list item's own hover/pressed backplate stays hidden. -->
    <UserControl.Resources><SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent"/></UserControl.Resources>
    <StackPanel x:Name="Row" Spacing="12" Margin="0,12,0,16">
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
            <Button Grid.Column="1" Content="See all" Click="SeeAll_Click" AutomationProperties.Name="See all catalog titles"/>
        </Grid>
        <ComboBox x:Name="FacetPicker" Visibility="Collapsed" SelectionChanged="Facet_Changed" AutomationProperties.Name="Catalog selection"/>
        <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="False" Visibility="Collapsed"/>
        <InfoBar x:Name="Error" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton></InfoBar>
        <TextBlock x:Name="Empty" Text="No titles are available in this catalog." Visibility="Collapsed"/>
        <ListView x:Name="Cards" Padding="6,6,6,0" Margin="-6,-6,-6,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Card_Click" ContainerContentChanging="Card_Changing" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.IsVerticalScrollChainingEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Disabled" >
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Margin" Value="0,0,16,4"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:MediaCard">
                <StackPanel Width="{x:Bind Width}" Spacing="8"><Border views:CardLift.IsEnabled="True" Height="{x:Bind ImageHeight}" CornerRadius="{x:Bind Corners}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image Source="{x:Bind Image}" Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw"/></Border>
                    <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</UserControl>

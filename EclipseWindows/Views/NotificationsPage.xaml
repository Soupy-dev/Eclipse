<Page x:Class="Eclipse.Windows.Views.NotificationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="Notifications">
 <ScrollViewer Background="{ThemeResource EclipsePageBrush}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24" MaxWidth="920" Spacing="20" HorizontalAlignment="Stretch">
   <Button Content="Back" Click="Back_Click" HorizontalAlignment="Left"/>
   <TextBlock Text="Notifications" FontSize="28" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
   <InfoBar x:Name="Notice" IsOpen="False" Severity="Warning" IsClosable="True"/>
   <TextBlock x:Name="Access" TextWrapping="Wrap"/>
   <Button Content="Windows notification settings" Click="SystemSettings_Click" HorizontalAlignment="Left"/>
   <ComboBox x:Name="EpisodeLead" Header="Episode reminders" SelectionChanged="Timing_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="At airtime" Tag="0"/><ComboBoxItem Content="15 minutes before" Tag="900"/><ComboBoxItem Content="1 hour before" Tag="3600"/><ComboBoxItem Content="1 day before" Tag="86400"/></ComboBox>
   <ComboBox x:Name="SeasonLead" Header="Season premieres" SelectionChanged="Timing_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="On premiere day" Tag="0"/><ComboBoxItem Content="1 day before" Tag="86400"/><ComboBoxItem Content="1 week before" Tag="604800"/></ComboBox>
   <ToggleSwitch x:Name="Specials" Header="Include anime specials in followed episodes" Toggled="Specials_Toggled"/>
   <TextBlock Text="Individual episode reminders are independent. Future seasons use confirmed premiere dates at 9:00 AM local time. Open Eclipse periodically to discover new releases and changed dates." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <Button x:Name="Refresh" Content="Refresh reminders" Click="Refresh_Click" HorizontalAlignment="Left"/>
   <TextBlock x:Name="Pending" TextWrapping="Wrap"/>
   <ProgressBar x:Name="Busy" IsIndeterminate="False" Visibility="Collapsed" Height="3"/>
   <Expander x:Name="Following" Header="Following" HorizontalAlignment="Stretch" Expanding="Section_Expanding"><StackPanel x:Name="Follows" Spacing="12"/></Expander>
   <Expander x:Name="Individual" Header="Individual episodes" HorizontalAlignment="Stretch" Expanding="Section_Expanding"><StackPanel x:Name="Episodes" Spacing="12"/></Expander>
   <Expander x:Name="Center" Header="Notification center" HorizontalAlignment="Stretch" Expanding="Section_Expanding"><StackPanel Spacing="14"><TextBlock Text="Alerts observed in Windows Notification Center or opened from a notification. Recorded time is when Eclipse observed the alert." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button Content="Clear history" Click="ClearHistory_Click" HorizontalAlignment="Left"/><StackPanel x:Name="History" Spacing="12"/><Button x:Name="More" Content="Show more" Click="More_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
   <Button x:Name="ClearSelections" Content="Remove all notification selections" Click="ClearSelections_Click" HorizontalAlignment="Left"/>
  </StackPanel>
 </ScrollViewer>
</Page>

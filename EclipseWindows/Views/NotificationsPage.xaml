<Page x:Class="Eclipse.Windows.Views.NotificationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Eclipse.Windows.Views" AutomationProperties.Name="Notifications" SizeChanged="Page_SizeChanged">
 <Grid>
 <ScrollViewer x:Name="Scroll" Background="Transparent" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
  <StackPanel x:Name="Form" Margin="36,28,36,48" HorizontalAlignment="Left">
   <views:SettingsHeader Trail="Settings|Notifications" />
   <InfoBar x:Name="Notice" IsOpen="False" Severity="Warning" IsClosable="True" Margin="0,16,0,0" />
   <TextBlock Text="Windows" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
   <Border Style="{StaticResource SettingsCardStyle}">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Notification access" /><TextBlock x:Name="Access" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
     <Button Grid.Column="1" Content="Open Windows settings" Click="SystemSettings_Click" VerticalAlignment="Center" />
    </Grid>
   </Border>
   <TextBlock Text="Timing" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
   <StackPanel Spacing="4">
    <Border Style="{StaticResource SettingsCardStyle}">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Episode reminders" /><TextBlock Text="When followed episodes and individual reminders alert you." Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <ComboBox x:Name="EpisodeLead" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Timing_Changed" AutomationProperties.Name="Episode reminders"><ComboBoxItem Content="At airtime" Tag="0" /><ComboBoxItem Content="15 minutes before" Tag="900" /><ComboBoxItem Content="1 hour before" Tag="3600" /><ComboBoxItem Content="1 day before" Tag="86400" /></ComboBox>
     </Grid>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Season premieres" /><TextBlock Text="Future seasons use confirmed premiere dates at 9:00 AM local time." Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <ComboBox x:Name="SeasonLead" Grid.Column="1" MinWidth="200" VerticalAlignment="Center" SelectionChanged="Timing_Changed" AutomationProperties.Name="Season premieres"><ComboBoxItem Content="On premiere day" Tag="0" /><ComboBoxItem Content="1 day before" Tag="86400" /><ComboBoxItem Content="1 week before" Tag="604800" /></ComboBox>
     </Grid>
    </Border>
    <Border Style="{StaticResource SettingsCardStyle}">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Anime specials" /><TextBlock Text="Include anime specials in followed episodes." Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <ToggleSwitch x:Name="Specials" Grid.Column="1" MinWidth="0" VerticalAlignment="Center" Toggled="Specials_Toggled" AutomationProperties.Name="Include anime specials in followed episodes" />
     </Grid>
    </Border>
   </StackPanel>
   <TextBlock Text="Individual episode reminders are independent. Open Eclipse periodically to discover new releases and changed dates." Style="{StaticResource SettingsDescriptionStyle}" Margin="2,10,0,0" />
   <TextBlock Text="Scheduled" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
   <Border Style="{StaticResource SettingsCardStyle}">
    <StackPanel Spacing="10">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Scheduled alerts" /><TextBlock x:Name="Pending" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <Button x:Name="Refresh" Grid.Column="1" Content="Refresh reminders" Click="Refresh_Click" VerticalAlignment="Center" />
     </Grid>
     <ProgressBar x:Name="Busy" IsIndeterminate="False" Visibility="Collapsed" Height="3" />
    </StackPanel>
   </Border>
   <TextBlock Text="Manage" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
   <StackPanel Spacing="4">
    <Button x:Name="CenterLink" Style="{StaticResource SettingsNavigationCardStyle}" Tag="center" Click="Manage_Click" AutomationProperties.Name="Notification Center">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Notification Center" /><TextBlock x:Name="CenterSummary" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
     </Grid>
    </Button>
    <Button x:Name="FollowingLink" Style="{StaticResource SettingsNavigationCardStyle}" Tag="following" Click="Manage_Click" AutomationProperties.Name="Following">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Following" /><TextBlock x:Name="FollowingSummary" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
     </Grid>
    </Button>
    <Button x:Name="EpisodesLink" Style="{StaticResource SettingsNavigationCardStyle}" Tag="episodes" Click="Manage_Click" AutomationProperties.Name="Individual episodes">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Individual episodes" /><TextBlock x:Name="EpisodesSummary" Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
      <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
     </Grid>
    </Button>
   </StackPanel>
   <TextBlock Text="Reset" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
   <Border Style="{StaticResource SettingsCardStyle}">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Remove all notification selections" /><TextBlock Text="Clears every follow and individual episode reminder on this device." Style="{StaticResource SettingsDescriptionStyle}" /></StackPanel>
     <Button x:Name="ClearSelections" Grid.Column="1" Content="Remove all" Click="ClearSelections_Click" VerticalAlignment="Center" />
    </Grid>
   </Border>
  </StackPanel>
 </ScrollViewer>
 <ListView x:Name="Rows" Visibility="Collapsed" Background="Transparent" Padding="36,28,36,48" SelectionMode="None" IsItemClickEnabled="False" ItemContainerStyle="{StaticResource SettingsListItemStyle}" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
  <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="1" /></ItemsPanelTemplate></ListView.ItemsPanel>
  <ListView.Header>
   <StackPanel Margin="0,0,0,16">
    <views:SettingsHeader x:Name="RowsHeader" />
    <InfoBar x:Name="RowsNotice" IsOpen="False" Severity="Warning" IsClosable="True" Margin="0,16,0,0" />
    <TextBlock x:Name="RowsDescription" Style="{StaticResource SettingsDescriptionStyle}" Margin="2,16,0,0" />
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
     <Button x:Name="ClearHistory" Content="Clear history" Click="ClearHistory_Click" Visibility="Collapsed" />
    </StackPanel>
    <ProgressBar x:Name="RowsBusy" IsIndeterminate="False" Visibility="Collapsed" Height="3" Margin="0,12,0,0" />
    <TextBlock x:Name="RowsEmpty" Style="{StaticResource SettingsDescriptionStyle}" Margin="2,12,0,0" Visibility="Collapsed" />
   </StackPanel>
  </ListView.Header>
  <ListView.ItemTemplate>
   <DataTemplate x:DataType="views:NotificationRow">
    <Grid ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Spacing="2" VerticalAlignment="Center">
      <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SettingsDescriptionStyle}" />
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button Content="{x:Bind PrimaryLabel}" Visibility="{x:Bind HasPrimary}" Click="RowPrimary_Click" AutomationProperties.Name="{x:Bind PrimaryName}" />
      <Button Content="{x:Bind SecondaryLabel}" Click="RowSecondary_Click" AutomationProperties.Name="{x:Bind SecondaryName}" />
     </StackPanel>
    </Grid>
   </DataTemplate>
  </ListView.ItemTemplate>
  <ListView.Footer>
   <Button x:Name="More" Content="Show more" Click="More_Click" Visibility="Collapsed" Margin="0,8,0,0" />
  </ListView.Footer>
 </ListView>
 </Grid>
</Page>

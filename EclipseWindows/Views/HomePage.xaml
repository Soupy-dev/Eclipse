<Page x:Class="Eclipse.Windows.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" NavigationCacheMode="Required" AutomationProperties.Name="Home">
    <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked"/></Grid.KeyboardAccelerators>
        <ListView x:Name="HomeList" SelectionMode="None" Padding="28,0,28,32" HorizontalContentAlignment="Stretch" IsTabStop="False" Loaded="List_Loaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5"/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
            <ListView.Header>
                <StackPanel Spacing="16" Margin="0,0,0,12">
                    <InfoBar x:Name="Error" Visibility="Collapsed" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton></InfoBar>
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="False" Height="3" Visibility="Collapsed"/>
                    <TextBlock x:Name="Empty" Text="No Home catalogs are enabled. Choose rows in Settings → Catalogs." Visibility="Collapsed" TextWrapping="Wrap" Margin="12,24"/>
                    <Border x:Name="Hero" Margin="-28,0,-28,8" Visibility="Collapsed" PointerEntered="Hero_Entered" PointerExited="Hero_Exited" GotFocus="Hero_GotFocus" LostFocus="Hero_LostFocus">
                        <Grid x:Name="HeroGrid" MinHeight="420" SizeChanged="HeroGrid_SizeChanged">
                            <!-- Artwork slots for the current title and the next two; filled in code. They extend below
                                 the banner so each image's colours bleed into the page (HeroArtwork.Tail). -->
                            <Grid x:Name="HeroArt" Margin="0,0,0,-200" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                            <Canvas x:Name="HeroLogoPreload" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                            <Grid x:Name="HeroShadeHost" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                            <Rectangle x:Name="HeroContrastPlate" Fill="{ThemeResource EclipseHeroShadeBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="HeroCard" MaxWidth="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,64,40,66">
                                <Border.RenderTransform><TranslateTransform x:Name="HeroCardShift"/></Border.RenderTransform>
                                <StackPanel Spacing="14">
                                    <Image x:Name="HeroLogo" MaxWidth="360" MaxHeight="112" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.HeadingLevel="Level1"/>
                                    <TextBlock x:Name="HeroTitle" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource EclipseHeroTextBrush}" AutomationProperties.HeadingLevel="Level1"/>
                                    <TextBlock x:Name="HeroMetadata" FontSize="14" Foreground="{ThemeResource EclipseHeroSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HeroSynopsis" FontSize="16" LineHeight="24" MaxLines="2" TextTrimming="WordEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource EclipseHeroSecondaryBrush}"/>
                                    <views:RatingStrip x:Name="HeroRatings"/>
                                    <Button x:Name="Explore" Content="View details" Click="Explore_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,10"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="HeroPaging" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="28,20"><TextBlock x:Name="HeroPosition" Foreground="{ThemeResource EclipseHeroTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Click="Previous_Click" AutomationProperties.Name="Previous featured title" ToolTipService.ToolTip="Previous featured title"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button><Button Click="Next_Click" AutomationProperties.Name="Next featured title" ToolTipService.ToolTip="Next featured title"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:HomeCatalog"><views:CatalogRow Catalog="{Binding}" TitleRequested="Row_TitleRequested" CatalogRequested="Row_CatalogRequested"/></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

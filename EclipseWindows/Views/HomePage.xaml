<Page x:Class="Eclipse.Windows.Views.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" NavigationCacheMode="Required" AutomationProperties.Name="Home">
    <Grid x:Name="Root" Background="{ThemeResource EclipsePageBrush}" SizeChanged="Root_SizeChanged" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators><KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked"/></Grid.KeyboardAccelerators>
        <ListView x:Name="HomeList" SelectionMode="None" Padding="28,20,28,32" HorizontalContentAlignment="Stretch" IsTabStop="False" Loaded="List_Loaded" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5"/></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
            <ListView.Header>
                <StackPanel Spacing="16" Margin="0,0,0,12">
                    <InfoBar x:Name="Error" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton></InfoBar>
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="False" Height="3" Visibility="Collapsed"/>
                    <TextBlock x:Name="Empty" Text="No Home catalogs are enabled. Choose rows in Settings → Catalogs." Visibility="Collapsed" TextWrapping="Wrap" Margin="12,24"/>
                    <Border x:Name="Hero" CornerRadius="18" Visibility="Collapsed">
                        <Grid x:Name="HeroGrid" MinHeight="420">
                            <Grid.Background><ImageBrush x:Name="HeroArtwork" Stretch="UniformToFill"/></Grid.Background>
                            <Rectangle Fill="{ThemeResource EclipseHeroShadeBrush}" IsHitTestVisible="False"/><Rectangle Fill="{ThemeResource EclipseHeroFadeBrush}" IsHitTestVisible="False"/>
                            <Border x:Name="HeroCard" MaxWidth="580" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,44,28,76" Padding="24" CornerRadius="22" Background="{ThemeResource EclipseHeroCardBrush}" BorderBrush="#22FFFFFF" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock x:Name="HeroSource" FontSize="12" CharacterSpacing="100" Foreground="{ThemeResource EclipseHeroSecondaryBrush}"/>
                                    <Image x:Name="HeroLogo" MaxWidth="340" Height="96" HorizontalAlignment="Left" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.HeadingLevel="Level1"/>
                                    <TextBlock x:Name="HeroTitle" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource EclipseHeroTextBrush}" AutomationProperties.HeadingLevel="Level1"/>
                                    <TextBlock x:Name="HeroMetadata" FontSize="14" Foreground="{ThemeResource EclipseHeroSecondaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HeroSynopsis" FontSize="16" LineHeight="24" MaxLines="3" TextTrimming="WordEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource EclipseHeroSecondaryBrush}"/>
                                    <Button x:Name="Explore" Content="View details" Click="Explore_Click" Style="{StaticResource AccentButtonStyle}" Padding="20,10"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"><TextBlock x:Name="HeroPosition" Foreground="{ThemeResource EclipseHeroTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="‹" Click="Previous_Click" AutomationProperties.Name="Previous featured title"/><Button Content="›" Click="Next_Click" AutomationProperties.Name="Next featured title"/></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ListView.Header>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:HomeCatalog"><views:CatalogRow Catalog="{Binding}" TitleRequested="Row_TitleRequested" CatalogRequested="Row_CatalogRequested"/></DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

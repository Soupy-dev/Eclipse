<Page x:Class="Eclipse.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Eclipse.Windows.Views" AutomationProperties.Name="Settings">
    <ScrollViewer x:Name="Scroll" Background="Transparent" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Form" Margin="36,28,36,48" HorizontalAlignment="Left">
            <views:SettingsHeader Trail="Settings" />
            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,20,0,0" Padding="20,16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/EclipseTileIcon.png" Width="56" Height="56" AutomationProperties.Name="Eclipse" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Eclipse" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

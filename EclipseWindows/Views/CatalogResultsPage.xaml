<Page x:Class="Eclipse.Windows.Views.CatalogResultsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models">
    <Grid Background="{ThemeResource EclipsePageBrush}" Padding="20" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="12"><Button Content="Back" Click="Back_Click"/><TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Row="1" Spacing="8"><ProgressBar x:Name="BusyBar" IsIndeterminate="False" Height="3" Visibility="Collapsed"/><InfoBar x:Name="Error" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Retry" Click="More_Click"/></InfoBar.ActionButton></InfoBar></StackPanel>
        <GridView x:Name="Titles" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Title_Click" SizeChanged="Titles_SizeChanged" ContainerContentChanging="Title_Changing">
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="330"/></ItemsPanelTemplate></GridView.ItemsPanel>
            <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
            <GridView.ItemTemplate><DataTemplate x:DataType="models:MediaTitle"><StackPanel Spacing="8"><Viewbox Stretch="Uniform"><Border Width="164" Height="246" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image Source="{x:Bind Poster}" Stretch="UniformToFill"/></Border></Viewbox><TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></GridView.ItemTemplate>
        </GridView>
        <Button x:Name="More" Grid.Row="3" Content="Load more" Click="More_Click" HorizontalAlignment="Right"/>
    </Grid>
</Page>

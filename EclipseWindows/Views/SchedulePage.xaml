<Page x:Class="Eclipse.Windows.Views.SchedulePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" AutomationProperties.Name="Schedule">
 <Page.Resources>
  <DataTemplate x:Key="WideEntry" x:DataType="models:ScheduleDisplayRow">
   <Border Padding="12" Margin="0,0,0,8" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <views:SchedulePoster Row="{x:Bind}" Width="60" Height="90"/>
     <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"/><TextBlock Text="{x:Bind Episode}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Provider}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
     <Border Grid.Column="2" Padding="10,6" CornerRadius="14" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><TextBlock Text="{x:Bind Time}" FontWeight="SemiBold"/></Border>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="CompactEntry" x:DataType="models:ScheduleDisplayRow">
   <Border Padding="10" Margin="0,0,0,8" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <views:SchedulePoster Row="{x:Bind}" Width="48" Height="72" VerticalAlignment="Top"/>
     <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"/><TextBlock Text="{x:Bind Episode}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Time}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Provider}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
    </Grid>
   </Border>
  </DataTemplate>
 </Page.Resources>
 <Grid x:Name="Root" Background="{ThemeResource EclipsePageBrush}" Padding="24,20" RowSpacing="16" SizeChanged="Root_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="Controls" ColumnSpacing="10" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ComboBox x:Name="Mode" HorizontalAlignment="Stretch" SelectionChanged="Options_Changed" AutomationProperties.Name="Schedule mode"><ComboBoxItem Content="Anime" Tag="anime"/><ComboBoxItem Content="Western" Tag="western"/><ComboBoxItem Content="Combined" Tag="combined"/></ComboBox>
   <ComboBox x:Name="Range" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Options_Changed" AutomationProperties.Name="Schedule range"><ComboBoxItem Content="7 days" Tag="7"/><ComboBoxItem Content="14 days" Tag="14"/><ComboBoxItem Content="21 days" Tag="21"/><ComboBoxItem Content="30 days" Tag="30"/></ComboBox>
   <ComboBox x:Name="Zone" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="Zone_Changed" AutomationProperties.Name="Schedule time zone"><ComboBoxItem Content="Local time" Tag="local"/><ComboBoxItem Content="UTC" Tag="utc"/></ComboBox>
   <Button x:Name="Refresh" Grid.Column="3" Click="Refresh_Click" ToolTipService.ToolTip="Refresh calendar" AutomationProperties.Name="Refresh calendar"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
  </Grid>
  <ListView x:Name="Day" Grid.Row="1" SelectionMode="Single" SelectionChanged="Day_Changed" Height="118" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.IsVerticalScrollChainingEnabled="False" AutomationProperties.Name="Schedule day">
   <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
   <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="12"/></Style></ListView.ItemContainerStyle>
   <ListView.ItemTemplate><DataTemplate x:DataType="models:ScheduleDay"><StackPanel Width="80" Padding="8" Spacing="3"><TextBlock Text="{x:Bind DayLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind Number}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="{x:Bind CountLabel}" FontSize="12" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListView.ItemTemplate>
  </ListView>
  <StackPanel Grid.Row="2" Spacing="8"><ProgressBar x:Name="BusyBar" IsIndeterminate="False" Visibility="Collapsed" Height="3"/><InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" Severity="Informational"/></StackPanel>
  <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DayHeading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/><TextBlock x:Name="DayCount" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
  <Grid Grid.Row="4"><TextBlock x:Name="Empty" Text="No episodes scheduled" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   <ListView x:Name="Entries" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Entry_Click" ContainerContentChanging="Entry_Changing" ItemTemplate="{StaticResource WideEntry}" AutomationProperties.Name="Airing episodes" HorizontalContentAlignment="Stretch">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
   </ListView>
  </Grid>
 </Grid>
</Page>

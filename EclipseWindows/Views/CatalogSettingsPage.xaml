<Page x:Class="Eclipse.Windows.Views.CatalogSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" AutomationProperties.Name="Catalogs" SizeChanged="Page_SizeChanged">
    <ListView x:Name="CatalogList" Background="Transparent" Padding="36,28,36,48" SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="Catalogs_Reordered" ContextRequested="Catalogs_ContextRequested" KeyboardAcceleratorPlacementMode="Hidden" ItemContainerStyle="{StaticResource SettingsListItemStyle}" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Home catalogs">
        <ListView.KeyboardAccelerators>
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="MoveUp_Invoked" />
            <KeyboardAccelerator Key="Down" Modifiers="Menu" Invoked="MoveDown_Invoked" />
        </ListView.KeyboardAccelerators>
        <ListView.Header>
            <StackPanel Margin="0,0,0,16">
                <views:SettingsHeader Trail="Settings|Catalogs" />
                <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource SettingsDescriptionStyle}" Margin="2,16,0,0" Text="Turn rows on or off and drag them to change their order on Home. Right-click a row, or press Alt+Up and Alt+Down, to move it without dragging. History, addon and tracker rows stay empty until their service is available on Windows." />
            </StackPanel>
        </ListView.Header>
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:HomeCatalog">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE76F;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource SettingsDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsOn="{x:Bind IsEnabled}" Toggled="Enabled_Toggled" MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Name}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>

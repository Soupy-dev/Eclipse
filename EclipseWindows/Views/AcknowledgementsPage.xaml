<Page x:Class="Eclipse.Windows.Views.AcknowledgementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Eclipse.Windows.Views" AutomationProperties.Name="Third-Party Notices">
    <ScrollViewer x:Name="Scroll" Background="Transparent" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Form" Margin="36,28,36,48" HorizontalAlignment="Left">
            <views:SettingsHeader Trail="Settings|Legal &amp; Source|Third-Party Notices" />
            <TextBlock Text="Services and components used by Eclipse for Windows." Style="{StaticResource SettingsDescriptionStyle}" Margin="2,16,0,0" />
            <TextBlock Text="Services" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <StackPanel Spacing="4">
                <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16"><StackPanel Spacing="12">
                    <Image Source="ms-appx:///Assets/TMDBLogo.svg" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="TMDB" />
                    <TextBlock Text="Movie and television metadata and artwork." TextWrapping="Wrap" />
                    <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." Style="{StaticResource SettingsDescriptionStyle}" />
                    <HyperlinkButton Content="The Movie Database" NavigateUri="https://www.themoviedb.org" HorizontalAlignment="Left" Padding="0,4" />
                </StackPanel></Border>
                <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16"><StackPanel Spacing="8">
                    <TextBlock Text="Connected libraries and ratings" FontWeight="SemiBold" />
                    <TextBlock Text="Account connections are optional. Service names and logos belong to their respective owners." Style="{StaticResource SettingsDescriptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <HyperlinkButton Content="Trakt" NavigateUri="https://trakt.tv" Padding="0,4" />
                        <HyperlinkButton Content="AniList" NavigateUri="https://anilist.co" Padding="0,4" />
                        <HyperlinkButton Content="MyAnimeList" NavigateUri="https://myanimelist.net" Padding="0,4" />
                    </StackPanel>
                </StackPanel></Border>
            </StackPanel>
            <TextBlock Text="Application framework" Style="{StaticResource SettingsSectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource SettingsCardStyle}" Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <HyperlinkButton Content=".NET" NavigateUri="https://github.com/dotnet/runtime" Padding="0,4" />
                    <HyperlinkButton Content="Windows App SDK" NavigateUri="https://github.com/microsoft/WindowsAppSDK" Padding="0,4" />
                    <HyperlinkButton Content="WinUI" NavigateUri="https://github.com/microsoft/microsoft-ui-xaml" Padding="0,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

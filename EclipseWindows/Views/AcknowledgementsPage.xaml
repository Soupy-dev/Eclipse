<Page x:Class="Eclipse.Windows.Views.AcknowledgementsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="Transparent" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="24" MaxWidth="1000">
            <Button Click="Back_Click" AutomationProperties.Name="Back to Legal and Source" ToolTipService.ToolTip="Back (Alt+Left)"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Back" /></StackPanel></Button>
            <TextBlock Text="Third-Party Notices" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="Services and components used by Eclipse for Windows." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="Services" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="16">
                <Image Source="ms-appx:///Assets/TMDBLogo.svg" Width="160" HorizontalAlignment="Left" AutomationProperties.Name="TMDB" />
                <TextBlock Text="Movie and television metadata and artwork." TextWrapping="Wrap" />
                <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB." TextWrapping="Wrap" />
                <HyperlinkButton Content="The Movie Database" NavigateUri="https://www.themoviedb.org" HorizontalAlignment="Left" />
            </StackPanel></Border>
            <TextBlock Text="Application framework" FontSize="20" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
            <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="10"><TextBlock Text="Connected libraries and ratings" FontSize="18" FontWeight="SemiBold"/><HyperlinkButton Content="Trakt" NavigateUri="https://trakt.tv" HorizontalAlignment="Left"/><HyperlinkButton Content="AniList" NavigateUri="https://anilist.co" HorizontalAlignment="Left"/><HyperlinkButton Content="MyAnimeList" NavigateUri="https://myanimelist.net" HorizontalAlignment="Left"/><TextBlock Text="Account connections are optional. Service names and logos belong to their respective owners." TextWrapping="Wrap"/></StackPanel></Border>
            <Border Padding="20" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="10">
                <HyperlinkButton Content=".NET" NavigateUri="https://github.com/dotnet/runtime" HorizontalAlignment="Left" />
                <HyperlinkButton Content="Windows App SDK" NavigateUri="https://github.com/microsoft/WindowsAppSDK" HorizontalAlignment="Left" />
                <HyperlinkButton Content="WinUI" NavigateUri="https://github.com/microsoft/microsoft-ui-xaml" HorizontalAlignment="Left" />
            </StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</Page>

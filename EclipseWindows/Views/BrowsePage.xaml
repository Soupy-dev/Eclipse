<Page x:Class="Eclipse.Windows.Views.BrowsePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" NavigationCacheMode="Required" AutomationProperties.Name="Browse">
    <Page.Resources><SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent"/></Page.Resources>
    <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
        <GridView x:Name="ResultsGrid" Margin="24,0,24,0" Padding="0,0,0,24" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Title_ItemClick" ContainerContentChanging="Results_ContainerContentChanging" SizeChanged="ResultsGrid_SizeChanged" AutomationProperties.Name="Browse results" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <GridView.Header>
                <StackPanel x:Name="HeaderLayout" Margin="8,28,8,12" Spacing="16">
                    <views:SettingsHeader Trail="Search|Browse" />
                    <SelectorBar x:Name="TypeBar" SelectionChanged="Type_Changed" AutomationProperties.Name="Type">
                        <SelectorBarItem Text="Movies" Tag="Movies" /><SelectorBarItem Text="TV Shows" Tag="TV Shows" /><SelectorBarItem Text="Anime" Tag="Anime" />
                    </SelectorBar>
                    <VariableSizedWrapGrid x:Name="Filters" Orientation="Horizontal" ItemWidth="200" ItemHeight="60" />
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="False" Visibility="Collapsed" Height="3" AutomationProperties.Name="Loading titles" />
                    <InfoBar x:Name="LoadError" IsOpen="False" IsClosable="False" Severity="Warning" Title="Unable to Load"><InfoBar.ActionButton><Button Content="Try Again" Click="Retry_Click" /></InfoBar.ActionButton></InfoBar>
                    <TextBlock x:Name="EmptyText" Text="No Results" Visibility="Collapsed" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </GridView.Header>
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="180" ItemHeight="330" CacheLength="1" /></ItemsPanelTemplate></GridView.ItemsPanel>
            <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="12" /></Style></GridView.ItemContainerStyle>
            <GridView.ItemTemplate><DataTemplate x:DataType="models:MediaTitle">
                <StackPanel Spacing="8">
                    <Viewbox Stretch="Uniform"><Border views:CardLift.IsEnabled="True" Width="164" Height="246" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image Stretch="UniformToFill" AutomationProperties.AccessibilityView="Raw" /></Border></Viewbox>
                    <TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate></GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

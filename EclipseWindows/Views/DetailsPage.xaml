<Page x:Class="Eclipse.Windows.Views.DetailsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views">
 <Page.Resources>
  <DataTemplate x:Key="EpisodeCard" x:DataType="models:MediaEpisode">
   <StackPanel Width="280" Padding="4" Spacing="8">
    <Border Height="158" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image Source="{x:Bind Still}" Stretch="UniformToFill"/></Border>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind EpisodeLabel}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Grid.Column="1" Padding="8,3" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock Text="{x:Bind Duration}" FontSize="12"/></Border></Grid>
    <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="{x:Bind Synopsis}" FontSize="13" LineHeight="18" MaxLines="2" TextWrapping="Wrap" TextTrimming="WordEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="EpisodeRow" x:DataType="models:MediaEpisode">
   <Grid Padding="8,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="{x:Bind NumberLabel}" FontSize="18" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind AirLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </Grid>
  </DataTemplate>
 </Page.Resources>
 <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
  <ScrollViewer x:Name="DetailsScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" IsTabStop="False">
   <StackPanel x:Name="PageLayout" Margin="0,0,0,40" Spacing="24">
    <ProgressBar x:Name="BusyBar" Margin="32,64,32,0" Visibility="Collapsed" Height="3" AutomationProperties.Name="Loading title details"/>
    <InfoBar x:Name="LoadError" Margin="32,64,32,0" Visibility="Collapsed" IsOpen="False" IsClosable="False" Severity="Warning"><InfoBar.ActionButton><Button Content="Retry" Click="Retry_Click"/></InfoBar.ActionButton></InfoBar>
    <Border x:Name="HeroFrame" Visibility="Collapsed">
     <Grid x:Name="HeroGrid" MinHeight="460">
      <!-- Fixed-height artwork (UpdateHeroLayout), so expanding the overview never rescales it; it reaches HeroArtwork.Tail below for the bleed. -->
      <Grid x:Name="HeroArt" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
      <Grid x:Name="HeroShadeHost" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
      <Rectangle x:Name="HeroContrastPlate" Fill="{ThemeResource EclipseHeroShadeBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border x:Name="HeroCard" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,100,32,48">
       <StackPanel Spacing="16">
        <Image x:Name="TitleArtwork" Stretch="Uniform" MaxWidth="380" MaxHeight="118" HorizontalAlignment="Left" Visibility="Collapsed"/>
        <TextBlock x:Name="TitleText" FontSize="44" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource EclipseHeroTextBrush}" AutomationProperties.HeadingLevel="Level1"/>
        <StackPanel x:Name="HeroDetails" Spacing="12"><TextBlock x:Name="MetadataText" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource EclipseHeroSecondaryBrush}"/></StackPanel>
        <TextBlock x:Name="ScheduleContext" Visibility="Collapsed" TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource EclipseHeroSecondaryBrush}"/>
        <StackPanel x:Name="OverviewSection" Spacing="4"><TextBlock x:Name="OverviewText" FontSize="15" LineHeight="23" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" Foreground="{ThemeResource EclipseHeroTextBrush}"/><Button x:Name="OverviewMore" Content="Read more" Click="OverviewMore_Click" Background="Transparent" Foreground="{ThemeResource EclipseHeroTextBrush}" Padding="0,6"/></StackPanel>
        <views:RatingStrip x:Name="RatingChip"/>
        <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Click="Play_Click" Padding="18,8" HorizontalAlignment="Left" Content="Play"/>
        <StackPanel x:Name="LibraryActions" Spacing="8"><Button Content="Collections" Click="Collections_Click"/><Button x:Name="YourRatingButton" Content="Your rating &amp; notes" Click="YourRating_Click"/></StackPanel>
        <Button x:Name="NotificationsButton" Content="Notifications" Click="Notifications_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>
    <StackPanel x:Name="BodySections" HorizontalAlignment="Left" Margin="32,0" Spacing="28" Visibility="Collapsed">
     <StackPanel x:Name="CastSection" HorizontalAlignment="Left" Spacing="12"><TextBlock Text="Cast" FontSize="23" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/><ListView x:Name="CastList" Height="180" SelectionMode="None" ContainerContentChanging="Cast_Changing" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.IsVerticalScrollChainingEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" CacheLength="1"/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate x:DataType="models:CastMember"><StackPanel Width="120" Margin="0,4,12,4" Spacing="7"><PersonPicture Width="96" Height="96" DisplayName="{x:Bind Name}" ProfilePicture="{x:Bind Portrait}"/><TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center"/><TextBlock Text="{x:Bind Character}" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
     <StackPanel x:Name="SeriesSection" Spacing="14">
      <TextBlock x:Name="EpisodesHeading" Text="Episodes" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2"/>
      <ComboBox x:Name="SeasonPicker" MinWidth="164" HorizontalAlignment="Left" PlaceholderText="Select season" SelectionChanged="Season_SelectionChanged" AutomationProperties.Name="Season"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:MediaSeason"><TextBlock Text="{x:Bind Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <StackPanel x:Name="SpecialsSection" Spacing="10" Visibility="Collapsed">
       <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Specials &amp; OVAs" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level3"/><Border Padding="8,2" CornerRadius="10" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock x:Name="SpecialsCount" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel>
       <ComboBox x:Name="SpecialPicker" MinWidth="164" HorizontalAlignment="Left" PlaceholderText="Select Special or OVA" SelectionChanged="Special_SelectionChanged" AutomationProperties.Name="Specials and OVAs"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:MediaSeason"><TextBlock Text="{x:Bind PickerLabel}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      </StackPanel>
      <ProgressBar x:Name="EpisodeBusy" Visibility="Collapsed" Height="3" AutomationProperties.Name="Loading episodes"/>
      <InfoBar x:Name="SeasonError" Visibility="Collapsed" IsOpen="False" IsClosable="False" Severity="Informational"><InfoBar.ActionButton><Button Content="Retry" Click="RetrySeason_Click"/></InfoBar.ActionButton></InfoBar>
      <ListView x:Name="EpisodeList" SelectionMode="Single" SelectionChanged="Episode_SelectionChanged" ContainerContentChanging="Episode_Changing" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Episodes"/>
      <Border x:Name="EpisodeSummary" Visibility="Collapsed" Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><StackPanel Spacing="8"><TextBlock x:Name="EpisodeHeading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="EpisodeSynopsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button x:Name="EpisodePlayButton" Click="EpisodePlay_Click" Content="Play"/></StackPanel></Border>
     </StackPanel>
     <Expander x:Name="StillsSection" Header="Stills" HorizontalAlignment="Left" Expanding="Stills_Expanding"><StackPanel x:Name="StillsContent" Spacing="10"/></Expander>
     <Expander x:Name="TrailersSection" Header="Trailers" HorizontalAlignment="Left" Expanding="Trailers_Expanding"><StackPanel x:Name="TrailersContent" Spacing="10"/></Expander>
     <Expander x:Name="SimilarSection" Header="Similar titles" HorizontalAlignment="Left" Expanding="Similar_Expanding">
      <StackPanel Spacing="10"><TextBlock x:Name="SimilarNotice" TextWrapping="Wrap"/><ListView x:Name="SimilarList" Height="310" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Similar_Click" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.IsVerticalScrollChainingEnabled="False" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent"/></ListView.Resources>
       <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" CacheLength="1"/></ItemsPanelTemplate></ListView.ItemsPanel>
       <ListView.ItemTemplate><DataTemplate x:DataType="models:MediaTitle"><StackPanel Width="154" Margin="4" Spacing="8"><Border views:CardLift.IsEnabled="True" Height="231" CornerRadius="10"><Image Source="{x:Bind Poster}" Stretch="UniformToFill"/></Border><TextBlock Text="{x:Bind Title}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView></StackPanel>
     </Expander>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
  <Button x:Name="BackButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,16" Click="Back_Click" Padding="10,8" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Alt+Left)"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button>
 </Grid>
</Page>

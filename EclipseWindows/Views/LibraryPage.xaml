<Page x:Class="Eclipse.Windows.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:Eclipse.Windows.Models" xmlns:views="using:Eclipse.Windows.Views" AutomationProperties.Name="Library">
 <Page.Resources>
  <DataTemplate x:Key="TitleCard" x:DataType="models:MediaTitle"><StackPanel Width="156" Spacing="8" Padding="4"><Border views:CardLift.IsEnabled="True" Height="222" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Image Source="{x:Bind Poster}" Stretch="UniformToFill"/></Border><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="CollectionCard" x:DataType="models:LibraryCollection"><views:LibraryCollectionCard Collection="{Binding}"/></DataTemplate>
  <DataTemplate x:Key="RemoteCard" x:DataType="models:TrackerEntry"><Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{x:Bind Title.Poster,Mode=OneWay}" Height="96" Stretch="UniformToFill"/><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title.Title,Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid></DataTemplate>
 </Page.Resources>
 <Grid Background="Transparent" Padding="24" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="BackButton" Click="Back_Click" Visibility="Collapsed" AutomationProperties.Name="Back to collections" ToolTipService.ToolTip="Back to collections"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button><ComboBox x:Name="Source" Width="140" SelectionChanged="Source_Changed" AutomationProperties.Name="Library source"/><Button Click="Create_Click" AutomationProperties.Name="New collection" ToolTipService.ToolTip="New collection"><FontIcon Glyph="&#xE710;" FontSize="14"/></Button><Button Click="Options_Click" AutomationProperties.Name="Library options" ToolTipService.ToolTip="Library options"><FontIcon Glyph="&#xE713;" FontSize="14"/></Button></StackPanel><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
  <StackPanel x:Name="RemoteFilters" Grid.Row="1" Spacing="10" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="RemoteList" Width="140" SelectionChanged="RemoteList_Changed" AutomationProperties.Name="Connected list"/><ComboBox x:Name="Kind" Width="90" SelectedIndex="0" SelectionChanged="RemoteList_Changed" AutomationProperties.Name="Media kind"><ComboBoxItem Content="Movies"/><ComboBoxItem Content="Shows"/></ComboBox><Button Click="Refresh_Click" AutomationProperties.Name="Refresh connected library" ToolTipService.ToolTip="Refresh"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button></StackPanel><TextBox x:Name="Filter" PlaceholderText="Search library" TextChanged="Filter_Changed"/><StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="StatusFilter" Width="130" SelectionChanged="Filter_Changed" AutomationProperties.Name="Status"/><ComboBox x:Name="GenreFilter" Width="130" SelectionChanged="Filter_Changed" AutomationProperties.Name="Genre"/></StackPanel></StackPanel>
  <StackPanel Grid.Row="2" Spacing="8"><ProgressBar x:Name="Busy" Height="3" Visibility="Collapsed"/><InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" Severity="Informational"/><TextBlock x:Name="Empty" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel>
  <ListView x:Name="Collections" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Collection_Click" ItemTemplate="{StaticResource CollectionCard}" RightTapped="Collection_RightTapped" HorizontalContentAlignment="Stretch">
   <ListView.Header><StackPanel Spacing="16" Margin="0,8,0,24"><StackPanel x:Name="BookmarksSection" Spacing="12"><TextBlock Text="Bookmarks" FontSize="24" FontWeight="SemiBold"/><ListView x:Name="Bookmarks" Height="304" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Title_Click" RightTapped="Title_RightTapped" ItemTemplate="{StaticResource TitleCard}" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent"/></ListView.Resources><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView><Button Content="Open Bookmarks" Click="Bookmarks_Click"/></StackPanel><TextBlock Text="Collections" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="NoCollections" Text="Create a collection to organize your titles." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><ListView x:Name="CollectionShelf" Height="272" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Collection_Click" RightTapped="Collection_RightTapped" ItemTemplate="{StaticResource CollectionCard}" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView></StackPanel></ListView.Header>
  </ListView>
  <GridView x:Name="Titles" Grid.Row="3" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Title_Click" ItemTemplate="{StaticResource TitleCard}" RightTapped="Title_RightTapped"><GridView.Resources><SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent"/><SolidColorBrush x:Key="GridViewItemPointerOverBorderBrush" Color="Transparent"/></GridView.Resources></GridView>
  <ListView x:Name="RemoteTitles" Grid.Row="3" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Remote_Click" ItemTemplate="{StaticResource RemoteCard}" RightTapped="Remote_RightTapped"/>
 </Grid>
</Page>

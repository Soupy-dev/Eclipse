<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(APP_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.Eclipse.Soupy.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>eclipse</string>
				<string>luna</string>
				<string>stremio</string>
			</array>
		</dict>
	</array>
	<key>EclipseDistributionChannel</key>
	<string>$(ECLIPSE_DISTRIBUTION_CHANNEL)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>EclipseSourceRevision</key>
	<string>$(ECLIPSE_SOURCE_REVISION)</string>
	<key>EclipseMPVKitSourceRevision</key>
	<string>$(ECLIPSE_MPVKIT_SOURCE_REVISION)</string>
	<!-- Mirrors the iOS target: plugin/Stremio manifests and stream URLs are frequently
	     plain http, which ATS would otherwise reject with -1022 only on Apple TV. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>TMDBAPIKey</key>
	<string>$(TMDB_API_KEY)</string>
	<key>AniListClientID</key>
	<string>$(ANILIST_CLIENT_ID)</string>
	<key>AniListClientSecret</key>
	<string>$(ANILIST_CLIENT_SECRET)</string>
	<key>AniListRedirectUri</key>
	<string>$(ANILIST_REDIRECT_URI)</string>
	<key>TraktClientID</key>
	<string>$(TRAKT_CLIENT_ID)</string>
	<key>TraktClientSecret</key>
	<string>$(TRAKT_CLIENT_SECRET)</string>
	<key>TraktRedirectUri</key>
	<string>$(TRAKT_REDIRECT_URI)</string>
	<key>MALClientID</key>
	<string>$(MAL_CLIENT_ID)</string>
	<key>MALClientSecret</key>
	<string>$(MAL_CLIENT_SECRET)</string>
	<key>MALRedirectUri</key>
	<string>$(MAL_REDIRECT_URI)</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
